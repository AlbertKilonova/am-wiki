# Cloudflare Pages → Settings → Environment variables（生产 + 预览都建议设置）
# 这些是构建期变量：改完必须重新部署（Retry deployment）才生效。
VITE_REPO_OWNER=YOUR_GITHUB_USER
VITE_REPO_NAME=am-wiki
VITE_REPO_BRANCH=main
VITE_SITE_URL=https://amw.mtga.top/

# 放在 CI / 本机 shell 里的密钥（不要提交）：
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
